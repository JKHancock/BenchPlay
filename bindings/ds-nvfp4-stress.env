# 绑定: DS-V4-Flash NVFP4 压力专项电池(TP2+EP2+dspark k2 产品口径, 与 cell15 同服务参数)
# 目的: 严苛负载画像 — 冷踩踏/超长冷prefill/多路超大/干扰战/池溢出/长输出马拉松
# 假设: 产品口径(1M×3准入, 池1.41M)下——干扰比(巨型prefill×短对话)可接受;
#       4×500K溢出触发优雅抢占而非雪崩; c8马拉松goodput稳定
# 依据: t20261005-dsnvfp4-1m-ep2(k2基线) / 断连盲区实测(2026-10-06, 与参数无关不在此测)
# 注意: 跳过能力套件/智能体/soak(标准电池已覆盖), 本电池纯性能压力画像
HEADER='# 压力专项电池: DS-V4-Flash NVFP4 产品口径(k2基线参数)
# w13冷踩踏→w7/w8/w9超长冷prefill→w10干扰战→w11池溢出→w12马拉松
# 预计时长~60-90min; 产出: 每workload独立json + 干扰比/溢出行为/马拉松衰减画像'
TASK_ID=t20261006-ds-stress
TAG=DsFlashN-TP2-1M-stress
LOAD_HINT='166.9GB加载预计10-20min'
MODEL_DIR=/root/.cache/huggingface/DeepSeek-V4-Flash-NVFP4
TP=2
DISTRIB_FLAG='--distributed-executor-backend ray'
EP_FLAG='--enable-expert-parallel'
MTP_FLAG="--speculative-config '{\"method\":\"dspark\",\"num_speculative_tokens\":2}'"
KERNEL_FLAG="--kernel-config '{\"enable_flashinfer_autotune\":false}'"
EXTRA_ARGS=''
PARSER=deepseek_v4
MODEL_NAME=ds-nvfp4
MEM_UTIL=0.85
MAX_LEN=1048576
MAX_SEQS=8
BATCHED=8192
T1_TIMEOUT=1800
WLOADS='w13-stampede w7-long128k w8-long256k-c4 w9-long500k w10-interfere w11-overflow w12-marathon'
THINK_PROBE_DESC='无(压力专项跳过)'
THINK_PROBE_BLOCK=''
SOAK_DESC='无(压力专项跳过)'
SOAK_BLOCK=''
CAP_BLOCK=''
AGENT_BLOCK=''
